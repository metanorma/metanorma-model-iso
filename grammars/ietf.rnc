include "relaton-ietf.rnc" { }
include "isodoc.rnc" {

ParagraphAttributes =
    attribute align { Alignments }?,
    attribute keep-with-next { xsd:boolean }?,
    attribute keep-with-previous { xsd:boolean }?,
    attribute indent { text }?

UlAttributes =
    attribute nobullet { xsd:boolean }?,
    attribute spacing { text }?,
    attribute indent { text }?,
    attribute bare { xsd:boolean }?

UlBody =
    li+, note*

OlAttributes =
    ## One of the named numbering styles, or a renderer-native numbering
    ## format string passed through for xml2rfc to expand, e.g. "R%d"
    ## (metanorma-model-iso#159; subsumes the former "text" named value)
    attribute type { ( "roman" | "alphabet" | "arabic" |
                       "roman_upper" | "alphabet_upper" | text ) },
    attribute group { text }?,
    attribute spacing { text }?,
    attribute start { text }?,
    attribute indent { text }?

OlBody =
    li+, note*

DlAttributes =
    attribute newline { text }?,
    attribute indent { text }?,
    attribute spacing { text }?

DlBody =
    (dt, dd)+, note*

NoteAttributes =
    attribute removeInRFC { text }?

NoteBody =
    tname?, paragraph+

PreAttributes =
    attribute alt { text }?,
    attribute align { text }?

xref =
  element xref {
     attribute target { xsd:IDREF },
     attribute type { ReferenceFormat }?,
     attribute alt { text }?,
     attribute format { text }?,
     XrefBody
}

quote-source =
  element source { erefTypeURI }

Clause-Section =
    Section-Attributes,
    attribute numbered { text }?,
    attribute removeInRFC { text }?,
    attribute toc { text }?,
    section-title?,
    (
      ( BasicBlock* ),
       (clause-subsection | terms | definitions)*
    )

annex =
  element annex {
    Annex-Section-Attributes,
    attribute numbered { text }?,
    attribute removeInRFC { text }?,
    attribute toc { text }?,
    section-title?,
    ( ( BasicBlock* ), clause-subsection* )
}

Content-Section =
    Section-Attributes,
    attribute numbered { text }?,
    attribute removeInRFC { text }?,
    attribute toc { text }?,
    section-title?,
    ( (BasicBlock*),
      content-subsection* )


index = element index {
  attribute to { xsd:IDREF }?,
  attribute primary { xsd:boolean }?,
  index-primary,
  index-secondary,
  index-tertiary
}

}

# end overrides

## RFC XML idiosyncratic attributes on cross-references to bibliographic
## entities. Additive augmentation of the base erefType: the former wholesale
## redefinition in the override block had rotted against the base grammar
## (bare mixed text predating ErefBody/display-text), and is retired per the
## flavor-override-elimination direction (metanorma-model-iso#158). NB @type
## thereby reverts to optional (base): requiredness cannot be tightened
## through &=; the generator always emits it
erefType &=
    ## Rendering format for the reference in RFC XML (xml2rfc displayFormat)
    attribute displayFormat { text }?,
    ## Reference target expressed relative to the containing document (xml2rfc relative)
    attribute relative { text }?

TextElement |= review

ReviewAttributes &=
  attribute display { text }?

ImageAttributes &=
    attribute align { text }?

SourceAttributes &=
    attribute markers { text }?

TableAttributes &=
    attribute align { text }?

erefTypeURI =
    attribute normative { xsd:boolean }?,
    attribute citeas { text }?,
    attribute type { ReferenceFormat },
    attribute alt { text }?,
    attribute displayFormat { text }?,
    attribute relative { text }?,
    attribute bibitemid { xsd:IDREF }?,
    attribute uri { xsd:anyURI }?,
    locality*, date?,
    text


